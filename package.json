{
  "name": "tanstack-cloudflare-dashboard-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "account": "wrangler whoami",
    "deploy": "echo 'BLOCKED: bare deploy is disabled so dev can never hit production. Use pnpm run deploy:staging or pnpm run deploy:production (see DEPLOY.md).' && exit 1",
    "deploy:staging": "vite build && wrangler deploy --env staging",
    "deploy:production": "vite build && wrangler deploy --env production",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply app_db --local",
    "db:migrate:remote": "echo 'BLOCKED: specify the remote database explicitly, e.g. wrangler d1 migrations apply app_db_production --remote (see DEPLOY.md).' && exit 1",
    "db:execute:local": "wrangler d1 execute app_db --local",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.35",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.52",
    "better-auth": "1.7.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.45.0",
    "motion": "^13.2.0",
    "re-resizable": "^6.11.2",
    "react": "19.3.0",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@cloudflare/vite-plugin": "1.54.8",
    "@cloudflare/vitest-plugin": "1.1.8",
    "@cloudflare/workers-types": "5.20260911.1",
    "@radix-ui/react-avatar": "1.1.10",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.18.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.2",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.131.1"
  }
}
